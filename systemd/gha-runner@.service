[Unit]
Description=Official GitHub Actions runner slot %i
Documentation=https://github.com/NDDev-OpenNetwork/github-actions-light
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=gha-runner
Group=gha-runner
WorkingDirectory=/opt/gha-runner/%i
Environment=HOME=/opt/gha-runner/%i
ExecStart=/opt/gha-runner/%i/run.sh
Restart=always
RestartSec=5s
TimeoutStopSec=90s
KillMode=control-group
UMask=0077

NoNewPrivileges=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectHome=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
ReadWritePaths=/opt/gha-runner/%i
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
SystemCallArchitectures=native
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=multi-user.target
